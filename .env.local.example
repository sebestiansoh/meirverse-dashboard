# ── Phase 2.1 · Foundation ────────────────────────────────────────────────
# Copy to .env.local and fill in values from your Supabase project dashboard.
# Set the same values in Vercel → Project → Settings → Environment Variables.
#
# Supabase API keys come in two formats; both work in these env vars:
#   • New (preferred):  sb_publishable_… (public) · sb_secret_… (server-only)
#   • Legacy (JWT):     eyJhbGciOi…  with role 'anon' or 'service_role'
# Use whichever your project shows in Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_REPLACE       # safe to expose client-side
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE                # NEVER expose · server-only · paste directly into Vercel
NEXT_PUBLIC_SITE_URL=https://dashboard.meirverse.app

# ── Phase 2.2 · Auth gate (Week 2) ────────────────────────────────────────
# Three-layer Workspace domain whitelist (keep all three in sync):
#   Layer 1 (network) — Cloudflare Access policy in the Cloudflare dashboard
#                       (set up at go-live, Week 7).
#   Layer 2 (IdP)     — Google OAuth `hd` parameter on the auth request URL
#                       for the primary shared Workspace tenant.
#   Layer 3 (app)     — server-side check in /auth/callback against
#                       ALLOWED_EMAIL_DOMAINS below. Load-bearing for
#                       independent venture-tenant Workspaces (Cubo, Caerus,
#                       MADE), because `hd` accepts only one value.
#
# Google OAuth client (Client ID + Secret) is held INSIDE Supabase, at
# Authentication → Providers → Google. The Next.js app does NOT need
# GOOGLE_CLIENT_ID/SECRET in its env.

# `hd` value for Layer 2 (publicly visible OK — just a domain name).
# NEXT_PUBLIC_ prefix so the client-side OAuth request can append it.
NEXT_PUBLIC_GOOGLE_PRIMARY_WORKSPACE_HD=meirverse.app

# Layer 3 allowlist — comma-separated, no spaces, server-side only.
# Empty/missing → all sign-ins denied (conservative default in
# lib/auth/domain-check.ts).
ALLOWED_EMAIL_DOMAINS=meirverse.app,example-tenant.com

# ── Phase 2.4 · Google APIs (Week 5) ──────────────────────────────────────
# GOOGLE_TASKS_REFRESH_TOKEN_ENC_KEY=
# Scopes — add to OAuth client as you wire each integration:
#   openid email profile
#   https://www.googleapis.com/auth/tasks
#   https://www.googleapis.com/auth/calendar.events.readonly
#   https://www.googleapis.com/auth/drive.readonly

# ── Phase 2.5 · CRM SSO bridge (Weeks 5–6) ────────────────────────────────
# RS256 keypair for signing 5-min audience-bound JWTs. Public key is also
# served at https://dashboard.meirverse.app/.well-known/jwks.json so CRMs
# can verify. Rotate every 90 days; publish both during a 24h overlap.
# JWT_PRIVATE_KEY_PEM=
# JWT_PUBLIC_KEY_PEM=
# JWT_KEY_ID=

# ── Phase E · WhatsApp Cloud API (Weeks 8–17) ─────────────────────────────
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
