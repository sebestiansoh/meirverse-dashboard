# ============================================================================
# .env.local.example
# ============================================================================
# Copy to .env.local for local dev. For production, set EACH of these in
# Vercel → Project → Settings → Environment Variables (Production scope).
# Treat the .env.local file as secret — `.gitignore` already excludes it.
#
# Supabase API keys come in two formats; both work in these env vars:
#   • New (preferred):  sb_publishable_… (public) · sb_secret_… (server-only)
#   • Legacy (JWT):     eyJhbGciOi…  with role 'anon' or 'service_role'
# Use whichever your project shows at Project Settings → API.


# ── Phase 2.1 · Foundation ───────────────────────────────────────────────────

# Supabase project. Found at Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_REPLACE       # safe to expose client-side
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE                # NEVER expose · server-only · paste directly into Vercel

# Site URL used in OAuth redirects and email templates. Set per-environment.
# Local dev:   http://localhost:3000
# Production:  https://dashboard.meirverse.app
NEXT_PUBLIC_SITE_URL=https://dashboard.meirverse.app


# ── Phase 2.2 · Auth gate (Week 2) ───────────────────────────────────────────
#
# Three-layer Workspace domain whitelist (keep all three in sync):
#   Layer 1 (network) — Cloudflare Access policy in the Cloudflare dashboard
#                       (set up at go-live, Week 7).
#   Layer 2 (IdP)     — Google OAuth `hd` parameter on the auth request URL
#                       for the primary shared Workspace tenant.
#   Layer 3 (app)     — server-side check in /auth/callback against
#                       ALLOWED_EMAIL_DOMAINS below. Load-bearing for
#                       independent venture-tenant Workspaces (Cubo, Caerus,
#                       MADE), because `hd` accepts only one value.
#
# Google OAuth client (Client ID + Secret) is held INSIDE Supabase for the
# auth dance itself. However Phase 2.4 (Google Tasks/Calendar/Drive) needs
# them in the APP env too — to mint refreshed access tokens against
# oauth2.googleapis.com/token. Same values you pasted into Supabase Auth →
# Providers → Google. Mark Sensitive in Vercel.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# `hd` value for Layer 2 (publicly visible OK — just a domain name).
# NEXT_PUBLIC_ prefix so the client-side OAuth request can append it.
# meir.sg is the primary Google Workspace tenant. (meirverse.app is the
# web hosting domain only — no mailboxes — so it must NOT be `hd` or in
# the allowlist below.)
NEXT_PUBLIC_GOOGLE_PRIMARY_WORKSPACE_HD=meir.sg

# Layer 3 allowlist — comma-separated, no spaces, server-side only.
# Empty/missing → all sign-ins denied (conservative default in
# lib/auth/domain-check.ts).
ALLOWED_EMAIL_DOMAINS=meir.sg,gcbuilders.com.sg


# ── Phase 2.3 · Persistent backend (Weeks 3–4) ───────────────────────────────
#
# Client-side AES-GCM key for the notes module (encrypted-at-rest in
# Supabase). Derived per-session in the browser; this env is the salt /
# rotation hint, NOT the key itself.
# Generate: openssl rand -hex 32
NEXT_PUBLIC_NOTES_KEY_SALT=replace_with_random_hex


# ── Phase 2.4 · Google APIs (Week 5) ─────────────────────────────────────────
#
# AES-256-GCM key for encrypting Google OAuth refresh + cached access
# tokens at rest in public.user_google_tokens. 32 bytes, base64-encoded.
# Generate: openssl rand -base64 32
# Mark Sensitive in Vercel.
GOOGLE_TASKS_REFRESH_TOKEN_ENC_KEY=

# Scopes requested at sign-in (see lib/google/scopes.ts).
# Must ALSO be added at Google Cloud Console → Data Access for users to
# be able to consent. Adding a new scope here without adding it there
# silently fails — users see "permission denied" from the Google API.
#   openid email profile
#   https://www.googleapis.com/auth/tasks
#   https://www.googleapis.com/auth/calendar.events.readonly
#   https://www.googleapis.com/auth/drive.readonly


# ── Phase 2.6 · Microsoft 365 APIs (Week 6) ──────────────────────────────────
#
# Azure Portal app registration (free; Microsoft developer account).
# Authentication → Add platform → Web → Redirect URI:
#   https://dashboard.meirverse.app/auth/callback
# Plus the same URL with http://localhost:3000 for dev.
#
# Certificates & secrets → New client secret → copy the VALUE (not ID).
# Paste both client id + secret into:
#   1. Supabase Auth → Providers → Azure (Supabase brokers the OAuth dance)
#   2. The two env vars below (used by lib/microsoft/refresh-access-token.ts
#      to mint refreshed access tokens against login.microsoftonline.com)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# AES-256-GCM key for encrypting Microsoft OAuth refresh + cached
# access tokens at rest in public.user_microsoft_tokens. Separate from
# the Google key so the two providers have independent blast radii on
# key compromise. 32 bytes, base64-encoded.
# Generate: openssl rand -base64 32
# Mark Sensitive in Vercel.
MICROSOFT_TOKEN_ENC_KEY=

# Microsoft Graph scopes requested at sign-in (see lib/microsoft/scopes.ts).
# Must ALSO be added under Azure Portal → App registrations → API permissions
# → Microsoft Graph → Delegated permissions, then "Grant admin consent".
#   openid email profile offline_access
#   https://graph.microsoft.com/Calendars.Read
#   https://graph.microsoft.com/Tasks.Read
#   https://graph.microsoft.com/Files.Read.All


# ── Phase 2.5 · CRM SSO bridge (Weeks 5–6) ───────────────────────────────────
#
# RS256 keypair for signing 5-minute audience-bound JWTs. Public key is also
# served at https://dashboard.meirverse.app/.well-known/jwks.json so CRMs
# can verify. Rotate every 90 days; publish BOTH keys during a 24h overlap.
#
# Generate (one-time):
#   openssl genrsa -out jwt-private.pem 2048
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
#   openssl rand -hex 8                                      # for JWT_KEY_ID
#   base64 -i jwt-private.pem                                # paste below
#   base64 -i jwt-public.pem                                 # paste below
#
# Why base64-wrap the PEMs: multi-line values in .env / Vercel env vars are
# painful. lib/auth/jwt-keys.ts decodes both base64 PEMs and raw PEMs, so
# either format works. Base64 is recommended — paste-safe everywhere.
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
JWT_KEY_ID=

# Key rotation — only set these for the 24h overlap window after generating a
# new keypair. Move the CURRENT vars above into these PREVIOUS slots and put
# the NEW vars above. Delete these PREVIOUS vars 24h later.
JWT_PRIVATE_KEY_PEM_PREVIOUS=
JWT_PUBLIC_KEY_PEM_PREVIOUS=
JWT_KEY_ID_PREVIOUS=

# Catalog of CRM audiences. Documentation only — the actual registry lives
# in lib/auth/audiences.ts (CRM_AUDIENCES). Keep this in sync with the file
# and with CRM-INVENTORY.md.
ALLOWED_SSO_AUDIENCES=hr,termsheet,engagement,prospect-db,spec-sheet,construction-erp,property-mgmt


# ── 2-way sync · service-principal secrets ──────────────────────────────────
#
# Per docs/2-way-sync.md, sibling CRMs request short-lived (5-min) service-
# token JWTs from /api/sso/mint-service-token. Each CRM authenticates with
# a long-lived HMAC bearer set here. Generate one per principal:
#   openssl rand -base64 48
#
# These secrets MUST match the SYNC_SVC_SECRET env var in each sibling
# CRM. Rotate any one and that CRM stops being able to emit until the
# corresponding env in its repo is updated.

SVC_PRINCIPAL_SECRET_HR=
SVC_PRINCIPAL_SECRET_CONSTRUCTION_ERP=
SVC_PRINCIPAL_SECRET_UNDERWRITING=


# ── Observability · Sentry (per Mandate §Observability & CI) ────────────────
#
# Sign up at sentry.io, create a Next.js project. DSN looks like:
#   https://<key>@o<orgid>.ingest.sentry.io/<projectid>
# When set, Sentry SDK initialises in sentry.client/server/edge.config.ts
# and captures exceptions + perf traces. When empty, SDK is a graceful
# no-op — build still succeeds, nothing captured.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Performance trace sampling (0.0–1.0). 0.1 = 10% of transactions sent.
# Internal-tool scale doesn't need more.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_TRACES_SAMPLE_RATE=0.1

# Source map upload at build time — optional, only if you want unminified
# stack traces in Sentry. Create an Auth Token at sentry.io/settings/auth-tokens
# with scope `project:releases` + `project:read`.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=


# ── Phase E · WhatsApp Cloud API (Weeks 8–17) ────────────────────────────────
#
# Set by Meta when you create the webhook subscription.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
